# ===== DeepSeek 云端 =====
# DeepSeek API Key，注册地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1   # 默认值，无需配置
# DEEPSEEK_MODEL=deepseek-chat                    # 默认值，无需配置

# ===== Ollama 本地（可选，不消耗 API token）=====
# 使用步骤：
#   1. 安装 Ollama 并拉取模型：ollama pull qwen3:8b
#   2. 取消下面两行注释，保存为 .env，重新启动项目
# OLLAMA_API_BASE=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=Qwen3-8B:latest

# ===== 性能调优（可选，均有默认值）=====
# GEN_CONCURRENCY=12            # DeepSeek 并发请求数
# GEN_OLLAMA_CONCURRENCY=2      # Ollama 并发请求数（本地推理，GPU/CPU 实测 2 最优）
# GEN_BATCH_SIZE=5              # DeepSeek 每次 API 调用生成的记录数
# GEN_OLLAMA_BATCH_SIZE=3       # Ollama 每次调用生成的记录数
# GEN_FILE_CONCURRENCY=3        # DeepSeek 批量任务文件级并发
# GEN_OLLAMA_FILE_CONCURRENCY=1 # Ollama 批量任务文件级并发（保持串行）
# DS_MAX_TOKENS=2500            # DeepSeek 单次调用最大输出 token
# OLLAMA_MAX_TOKENS=2000        # Ollama 单次调用最大输出 token
# LLM_RECENT_QUERY_LIMIT=12     # 传给 LLM 的已生成 query 上限（用于避免重复）
